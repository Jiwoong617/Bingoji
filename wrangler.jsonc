{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bingoji-multiplayer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-29",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://jiwoong617.github.io"
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BINGOJI_ROOMS",
        "class_name": "BingojiRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BingojiRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
